// ייבוא הספרייה node-fetch שמוגדרת ב-dependencies שלך
import fetch from 'node-fetch';

export const name = "Netfree";

export async function execute() {
    const url = "https://netfree.link/api/user/verify-phone/get-call";

    // גוף הבקשה בפורמט JSON
    const bodyData = {
        agreeTou: true,
        phone: "PHONE_INTL"
    };

    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(bodyData)
        });

        // קריאת התגובה כטקסט פשוט
        const responseData = await response.text();

        // לוג תוצאות
        console.log(`[Netfree] Status: ${response.status} | Response:`, responseData);
    } catch (error) {
        console.error('[Netfree] Error occurred:', error.message);
    }
}
